LUXE_DB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=luxe_ecommerce
LUXE_DB_USER=postgres
LUXE_DB_PASS=

# Local development can show the OTP on screen. Set to 0 in production.
LUXE_DEBUG_OTP=1
LUXE_DEBUG_API=0

# Set to 1 in production so checkout fails if email/SMS delivery is not working.
LUXE_REQUIRE_OTP_DELIVERY=0

# Email delivery. Prefer SendGrid for hosted sites, or set LUXE_MAIL_TRANSPORT=mail
# when your server has a working mail transfer agent.
LUXE_MAIL_TRANSPORT=log
LUXE_MAIL_FROM=orders@example.com
LUXE_MAIL_FROM_NAME=LUXE
LUXE_SENDGRID_API_KEY=

# SMS delivery through Twilio. Phone numbers should be entered in E.164 format.
LUXE_TWILIO_ACCOUNT_SID=
LUXE_TWILIO_AUTH_TOKEN=
LUXE_TWILIO_FROM=
