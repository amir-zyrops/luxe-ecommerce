LUXE_DB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=luxe_ecommerce
LUXE_DB_USER=postgres
LUXE_DB_PASS=

# Local development can show the OTP on screen. Set to 0 in production.
LUXE_DEBUG_OTP=1
LUXE_DEBUG_API=0

# Set to 1 in production so checkout fails if email delivery is not working.
LUXE_REQUIRE_OTP_DELIVERY=0

# Email OTP delivery through PHPMailer SMTP.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=orders@example.com
SMTP_FROM_NAME=LUXE

# Optional admin login for approving retailer-submitted products.
RETAILER_ADMIN_EMAIL=admin@example.com
RETAILER_ADMIN_PASSWORD=change-this-password
